{
  "name": "fastrack",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "koffi": "^3.3.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.fastrack.acc",
    "productName": "Fastrack",
    "files": [
      "dist/**",
      "electron/**",
      "Assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "Assets/FasTrackIcon.ico"
    }
  }
}
